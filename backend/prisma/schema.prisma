generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("staff")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payouts   Payout[]
}

model Balance {
  id        String   @id @default(uuid())
  provider  String
  currency  String
  amount    Decimal  @db.Decimal(18, 2)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@unique([provider, currency])
}

model FxQuote {
  id             String   @id @default(uuid())
  sourceCurrency String
  targetCurrency String
  midRate        Decimal  @db.Decimal(18, 6)
  provider       String?
  fetchedAt      DateTime @default(now())
  createdAt      DateTime @default(now())
  @@unique([sourceCurrency, targetCurrency])
}

model Payout {
  id               String   @id @default(uuid())
  beneficiaryName  String
  beneficiaryBank  String?
  beneficiaryAcct  String?
  corridor         String
  sourceCurrency   String
  targetCurrency   String
  sourceAmount     Decimal  @db.Decimal(18, 2)
  targetAmount     Decimal? @db.Decimal(18, 2)
  exchangeRate     Decimal? @db.Decimal(18, 6)
  provider         String
  status           String   @default("Draft")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id])
}
